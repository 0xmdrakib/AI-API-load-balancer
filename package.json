{
  "name": "ai-load-balancer",
  "version": "0.2.0",
  "private": true,
  "author": "0xmdrakib",
  "copyright": "Copyright © 2026 0xmdrakib",
  "description": "Dual-protocol OpenAI and Anthropic API load balancer with encrypted provider keys, failover, and a premium Windows desktop dashboard.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:desktop": "npm run build && electron .",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:pack": "powershell -ExecutionPolicy Bypass -File scripts/package-portable-folder.ps1",
    "desktop:pack:single": "npm run build && electron-builder --win portable --x64 --publish never",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "site:verify": "node scripts/verify-showcase.mjs",
    "site:preview": "node scripts/serve-showcase.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.2",
    "fastify": "5.11.0",
    "lucide-react": "0.577.0",
    "nanoid": "5.1.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.67.0",
    "@types/node": "22.18.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "openai": "6.39.0",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "com.local.ailoadbalancer",
    "productName": "AI Load Balancer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-web/**/*",
      "desktop/**/*",
      "icons/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "forceCodeSigning": false,
    "artifactName": "AI Load Balancer.${ext}"
  }
}
